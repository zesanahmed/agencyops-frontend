# Server-side only: where Next proxies /api/v1/* to (no trailing slash, no /api/v1).
BACKEND_ORIGIN=https://agencyops-api.vercel.app

# Leave unset to use the same-origin proxy (recommended; keeps the SameSite=Strict refresh cookie working).
# NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-click demo login. The defaults are the users created by the backend's `npm run seed` (owner@/manager@/member@demo.agencyops.test).
# Set these only to override them. They are public demo accounts; NEXT_PUBLIC_* values ship in the client bundle.
NEXT_PUBLIC_DEMO_OWNER_EMAIL=
NEXT_PUBLIC_DEMO_OWNER_PASSWORD=
NEXT_PUBLIC_DEMO_MANAGER_EMAIL=
NEXT_PUBLIC_DEMO_MANAGER_PASSWORD=
NEXT_PUBLIC_DEMO_MEMBER_EMAIL=
NEXT_PUBLIC_DEMO_MEMBER_PASSWORD=

# Optional public contact address for the /contact page (opens the visitor's mail client).
NEXT_PUBLIC_CONTACT_EMAIL=

# Social sign-in buttons (comma separated: google,github). Leave empty until the backend has the provider's credentials.
# Requires the backend's API_PUBLIC_URL to be THIS site's origin (so the provider callback, the state cookie and the refresh
# cookie all go through the /api/v1 proxy), and the provider's redirect URI set to <this origin>/api/v1/auth/oauth/<provider>/callback.
NEXT_PUBLIC_OAUTH_PROVIDERS=
